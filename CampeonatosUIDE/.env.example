# Copia este archivo como .env y rellena los valores. NUNCA subas .env a git.
# En la EC2, user-data.sh genera este archivo automaticamente la primera vez
# (SECRET_KEY y las contrasenas MySQL se crean con openssl y no salen de la maquina).

SECRET_KEY=replace-me-con-50-caracteres-o-mas
DEBUG=False
ALLOWED_HOSTS=campeonatos-uide.shop,www.campeonatos-uide.shop
CSRF_TRUSTED_ORIGINS=https://campeonatos-uide.shop,https://www.campeonatos-uide.shop

# Base de datos: MySQL dentro de Docker (servicio "db"). El host es "db",
# el nombre del servicio en compose.yaml.
DATABASE_URL=mysql://campeonatos:replace-db-pass@db:3306/campeonatos_uide

# Variables que consume el contenedor mysql:8.0 (deben cuadrar con DATABASE_URL).
MYSQL_DATABASE=campeonatos_uide
MYSQL_USER=campeonatos
MYSQL_PASSWORD=replace-db-pass
MYSQL_ROOT_PASSWORD=replace-root-pass

# Ponlo en True cuando ya tengas el certificado HTTPS emitido (certbot).
SECURE_SSL_REDIRECT=False

# SMTP opcional (reset de contrasena). Vacio = Django no envia correo.
SMTP_USER=
SMTP_PASS=
