# Copia como terraform.tfvars y ajusta. terraform.tfvars esta en .gitignore.

aws_region        = "us-east-1"
availability_zone = "us-east-1a"

# Rango de tu IP publica. Si es fija, usa /32; si es dinamica (ISP
# residencial), usa el /24 de tu proveedor para no perder acceso cada vez
# que cambie. Consiguela con: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.0/24"

# Clave publica SSH ya existente en tu maquina (genera una con ssh-keygen).
public_key_path = "C:/Users/tu-usuario/.ssh/campeonatos-uide.pub"
key_name        = "campeonatos-uide"

# Dominio real (Hostinger).
domain_name = "campeonatos-uide.shop"

# Repo que la EC2 clona en el arranque.
repository_url = "https://github.com/Dilan-DS/Campeonatos-UIDE.git"

# Base de datos MySQL en Docker. NOMBRE y USUARIO no son secretos.
# Las CONTRASENAS (usuario y root) NO se ponen aqui: user-data.sh las genera
# con openssl dentro de la EC2 y quedan solo en /opt/.../CampeonatosUIDE/.env
# (nunca en el state de Terraform ni en los datos de user-data).
db_name = "campeonatos_uide"
db_user = "campeonatos"
